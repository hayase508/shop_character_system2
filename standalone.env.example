CAMERA_ENABLED=true
CAMERA_INDEX=0
CAMERA_BACKEND=auto
CAMERA_WIDTH=1280
CAMERA_HEIGHT=720
CAMERA_FPS=15
CAMERA_RETRY_SECONDS=5

FACE_MATCH_THRESHOLD=0.5
FACE_FRAME_SKIP=5
FACE_IMAGE_SCALE=0.25
FACE_DETECTION_MODEL=hog
FACE_CONFIRMATION_COUNT=2
FACE_CONFIRMATION_WINDOW_SECONDS=4
CAMERA_EVENT_COOLDOWN_SECONDS=2

PERSON_COOLDOWN_SECONDS=20
GLOBAL_COOLDOWN_SECONDS=5
VISIT_COOLDOWN_MINUTES=60
DISCOUNT_VALID_DAYS=60
# Keep server timeout longer than browser playback timeout.
GREETING_TIMEOUT_SECONDS=190
BROWSER_GREETING_TIMEOUT_SECONDS=180

DATABASE_PATH=C:/Users/mitsuki/AppData/Local/IchigoCafe/shop.db
DEBUG_MODE=true
LOG_LEVEL=INFO
ACCESS_LOG=false
HOST=127.0.0.1
PORT=8000

CHARACTER_VIDEO_IDLE=/static/videos/idle_optimized.mp4
CHARACTER_VIDEO_WELCOME=/static/videos/yobidashi_mobile.mp4
CHARACTER_VIDEO_RETURNING=/static/videos/yobidashi_mobile.mp4
CHARACTER_VIDEO_SPEAKING_INTRO=/static/videos/shinfurimuki_optimized.mp4
CHARACTER_VIDEO_SPEAKING_LOOP=/static/videos/yobidashi_mobile.mp4
CHARACTER_AUDIO_WELCOME=/static/audio/first-visit.wav
CHARACTER_AUDIO_RETURNING=/static/audio/returning.wav
CHARACTER_AUDIO_RETURNING_DISCOUNT=/static/audio/returning-discount.wav

# Questions are accepted only after a face-triggered greeting finishes.
QUESTION_ENABLED=true
QUESTION_READY_TIMEOUT_SECONDS=40
QUESTION_RECORDING_MAX_SECONDS=15
QUESTION_SESSION_TIMEOUT_SECONDS=60
QUESTION_SPEAKING_TIMEOUT_SECONDS=45
QUESTION_AUDIO_MAX_BYTES=10485760
QUESTION_AUDIO_BITRATE=128000
# microphone: 音声質問 / touch: 別タッチパネル / both: 両方
QUESTION_INPUT_MODE=touch
# 空欄ならWindows/ブラウザの既定マイク。部分一致する製品名でUSBマイクを固定できます。
MICROPHONE_DEVICE_LABEL=
# 待機中に人の声らしい音を検知したら、タッチパネル利用を案内します（録音しません）。
ASSISTANCE_VOICE_ENABLED=true
ASSISTANCE_VOICE_COOLDOWN_SECONDS=20
ASSISTANCE_VOICE_START_THRESHOLD=0.010
ASSISTANCE_VOICE_START_DURATION_MS=200
ASSISTANCE_VOICE_CALIBRATION_MS=500
ASSISTANCE_VOICE_NOISE_MULTIPLIER=1.4
ASSISTANCE_VOICE_NOISE_MARGIN=0.0025
ASSISTANCE_VOICE_SPEECH_BAND_RATIO=0.20
ASSISTANCE_VOICE_ZCR_MIN=0.001
ASSISTANCE_VOICE_ZCR_MAX=0.45
# staff: FAQ外は固定音声でスタッフ案内。gemini: FAQ外をGeminiへ送信。
QUESTION_UNKNOWN_POLICY=staff

WHISPER_MODEL=base
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
WHISPER_TIMEOUT_SECONDS=30
WHISPER_BEAM_SIZE=3
WHISPER_MAX_NEW_TOKENS=80
WHISPER_INITIAL_PROMPT=いちごうカフェの店内で、お客様が鬼店員へ日本語で短い質問をしています。
WHISPER_HOTWORDS=いちごうカフェ 鬼 鬼さん 鬼店員 豚汁 たまご定食 お代わり コーヒー お茶 飲み物 QRコード 精算機 セルフサービス
WHISPER_DOMAIN_CORRECTIONS=true
WHISPER_NO_SPEECH_THRESHOLD=0.45
WHISPER_MIN_AVG_LOGPROB=-0.8
WHISPER_VAD_FILTER=true
WHISPER_VAD_MIN_SPEECH_MS=400
WHISPER_VAD_MIN_SILENCE_MS=350
WHISPER_VAD_SPEECH_PAD_MS=200

VAD_ENABLED=true
VAD_START_THRESHOLD=0.025
VAD_START_DURATION_MS=350
VAD_END_SILENCE_MS=450
VAD_MIN_SPEECH_MS=500
VAD_RESUME_DELAY_MS=800
VAD_PREROLL_MS=450
VAD_CALIBRATION_MS=1200
VAD_NOISE_MULTIPLIER=1.8
VAD_NOISE_MARGIN=0.006

# Keep this key only in .env. Never commit it.
GEMINI_ENABLED=false
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_TIMEOUT_SECONDS=10
GEMINI_MAX_OUTPUT_TOKENS=100
GEMINI_MAX_REQUESTS_PER_SESSION=3
GEMINI_CACHE_TTL_SECONDS=3600
GEMINI_MAX_QUESTION_CHARS=200
GEMINI_THINKING_LEVEL=minimal
GEMINI_PRELOAD=true
GEMINI_WARMUP=true

# Dynamic answers use the local VOICEVOX engine and Shikoku Metan.
VOICEVOX_ENABLED=false
VOICEVOX_ENGINE_URL=http://127.0.0.1:50021
VOICEVOX_SPEAKER_ID=2
VOICEVOX_TIMEOUT_SECONDS=15
VOICEVOX_CACHE_ENTRIES=64
VOICEVOX_SPEED_SCALE=1.08
VOICEVOX_PRELOAD=true
